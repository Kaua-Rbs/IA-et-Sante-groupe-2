# {{ ansible_managed }}
# Lu par podman-compose pour remplacer les ${...} de compose.yml : chaque service ne reçoit
# que les variables qu'il cite. Les commentaires restent sur leur propre ligne.

# PostgreSQL
POSTGRES_DB={{ kyst_postgres_db }}
POSTGRES_USER={{ kyst_postgres_user }}
POSTGRES_PASSWORD={{ kyst_postgres_password }}

# pgAdmin
PGADMIN_DEFAULT_EMAIL={{ kyst_pgadmin_email }}
PGADMIN_DEFAULT_PASSWORD={{ kyst_pgadmin_password }}
PGADMIN_LISTEN_ADDRESS=[::]
# Port dans le conteneur (80 sans TLS), publié sur 3001 par compose.yml
PGADMIN_LISTEN_PORT=80

# Images de l'API et du front
KYST_API_IMAGE={{ kyst_api_image }}
KYST_APP_IMAGE={{ kyst_app_image }}

# API (voir interface/kyst.env)
SECRET_KEY={{ kyst_secret_key }}
FIRST_ADMIN_EMAIL={{ kyst_first_admin_email }}
FIRST_ADMIN_PASSWORD={{ kyst_first_admin_password }}
ACCOUNT_VALIDATION={{ kyst_account_validation | string | lower }}
ACCESS_TOKEN_EXPIRE_MINUTES={{ kyst_access_token_expire_minutes }}
REFRESH_TOKEN_EXPIRE_DAYS={{ kyst_refresh_token_expire_days }}
AI_BACKEND={{ kyst_ai_backend }}
