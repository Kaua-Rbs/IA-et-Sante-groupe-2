# =============================================================================
# KYST — variables d'environnement (référence unique)
# =============================================================================
# Lu par l'API (interface/api/config.py) et par le front (interface/app/vite.config.ts,
# `node --env-file` en production). Ordre de priorité, du plus fort au plus faible :
#   1. variables d'environnement du processus
#   2. interface/kyst.local.env  (non versionné : vrais secrets, réglages personnels)
#   3. interface/kyst.env        (ce fichier : valeurs de développement, versionné)
#
# Ce fichier est versionné : n'y mettez JAMAIS de secret réel. Les valeurs « change-me »
# doivent être remplacées dans kyst.local.env ou dans l'environnement du serveur.
# Format : CLE=valeur, sans commentaire en fin de ligne.


# -----------------------------------------------------------------------------
# API — sécurité et sessions
# -----------------------------------------------------------------------------

# Clé de signature des jetons JWT. Générer avec : openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256

# Durées de vie des jetons, partagées avec le front (durée des cookies de session)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Limitation du nombre de tentatives de connexion (désactivée dans les tests)
RATE_LIMIT_ENABLED=true

# Origines autorisées à appeler l'API depuis un navigateur (liste JSON).
# Le front appelle l'API depuis son serveur : seul un client navigateur direct en a besoin.
CORS_ORIGINS=["http://localhost:5173"]


# -----------------------------------------------------------------------------
# API — comptes
# -----------------------------------------------------------------------------

# Si true, un nouveau compte doit être validé par un administrateur
ACCOUNT_VALIDATION=true

# Premier administrateur, créé au démarrage de l'API s'il n'existe pas encore.
# Laisser vide pour ne pas en créer.
FIRST_ADMIN_EMAIL=admin@kyst.fr
FIRST_ADMIN_PASSWORD=change-me-admin


# -----------------------------------------------------------------------------
# API — base de données
# -----------------------------------------------------------------------------

# SQLite en local (fichier créé dans le dossier où l'API est lancée).
# En déploiement : postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=sqlite:///kyst.db


# -----------------------------------------------------------------------------
# API — prédictions et ordonnancement
# -----------------------------------------------------------------------------

# Implémentation des prédictions et de l'ordonnanceur. Seul « fixtures » existe pour
# l'instant (valeurs de démonstration), en attendant les modèles et le solveur.
AI_BACKEND=fixtures

# Part de chaque vacation gardée libre pour les urgences (0.1 = 10 %)
EMERGENCY_MARGIN=0.1

# Nombre de dates proposées par demande (A, B, ...)
PROPOSAL_COUNT=2

# Horizon de recherche, en jours, quand la demande n'a pas de date limite
SCHEDULING_HORIZON_DAYS=60


# -----------------------------------------------------------------------------
# API — serveur de production (just prod)
# -----------------------------------------------------------------------------

# Adresse d'écoute de l'API. 127.0.0.1 : seule la machine (donc le front) peut l'appeler.
API_HOST=127.0.0.1
API_PORT=8000


# -----------------------------------------------------------------------------
# Front (SvelteKit)
# -----------------------------------------------------------------------------

# Adresse de l'API, appelée uniquement depuis le serveur SvelteKit (cohérente avec API_HOST/API_PORT)
KYST_API_URL=http://127.0.0.1:8000

# Serveur Node de production (adapter-node) : adresse et port d'écoute
HOST=0.0.0.0
PORT=3000

# URL publique du site, utilisée par la protection CSRF des formulaires.
# Elle est FIGÉE AU BUILD (just build / just prod) : reconstruire après l'avoir changée.
# Vide : déduite de l'en-tête Host en supposant https (cas d'un proxy TLS qui transmet Host).
# Les cookies de session sont « Secure » en production : servir le site en HTTPS (sauf localhost).
ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# Déploiement (compose : PostgreSQL et pgAdmin)
# -----------------------------------------------------------------------------

POSTGRES_DB=kyst
POSTGRES_USER=kyst
POSTGRES_PASSWORD=change-me
PGADMIN_DEFAULT_EMAIL=admin@kyst.fr
PGADMIN_DEFAULT_PASSWORD=change-me
